<?xml version="1.0" encoding="utf-8"?>
<!-- phone_id must stay unique per install, so settings are never copied to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
